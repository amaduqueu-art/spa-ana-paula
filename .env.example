# Copie para .env (local) ou configure como secrets no Cloudflare.

# Neon PostgreSQL - obrigatório
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require"

# Google AI Studio (Gemini) - obrigatório para a análise de imagens
GEMINI_API_KEY=""

# Segredo JWT - obrigatório em produção (gere com: openssl rand -base64 48)
JWT_SECRET=""

# Gmail para envio do e-mail de confirmação - opcional
# Atenção: sem estas variáveis o cadastro é confirmado automaticamente.
EMAIL_USER=""
EMAIL_PASS=""
